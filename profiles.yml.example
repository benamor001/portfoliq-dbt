# portfolIQ dbt package — profiles.yml template
# Copy this file to profiles.yml and fill in your credentials.
#
# The portfolIQ pack reads exclusively from the star_public schema
# on your PostgreSQL instance (read-only credentials are sufficient).
#
# NEVER commit your profiles.yml with real credentials.
# Add profiles.yml to your .gitignore.
#
# portfolIQ API documentation: https://portfoliq.io/docs/bi-package

portfoliq:
  target: dev
  outputs:

    dev:
      type: postgres
      host: "{{ env_var('PORTFOLIQ_DB_HOST', 'localhost') }}"
      port: "{{ env_var('PORTFOLIQ_DB_PORT', '5432') | int }}"
      user: "{{ env_var('PORTFOLIQ_DB_USER', 'portfoliq_reader') }}"
      password: "{{ env_var('PORTFOLIQ_DB_PASSWORD') }}"
      dbname: "{{ env_var('PORTFOLIQ_DB_NAME', 'portfoliq') }}"
      schema: star_public
      threads: 4
      keepalives_idle: 0
      connect_timeout: 10
      search_path: star_public

    prod:
      type: postgres
      host: "{{ env_var('PORTFOLIQ_DB_HOST') }}"
      port: "{{ env_var('PORTFOLIQ_DB_PORT', '5432') | int }}"
      user: "{{ env_var('PORTFOLIQ_DB_USER') }}"
      password: "{{ env_var('PORTFOLIQ_DB_PASSWORD') }}"
      dbname: "{{ env_var('PORTFOLIQ_DB_NAME', 'portfoliq') }}"
      schema: star_public
      threads: 8
      keepalives_idle: 0
      connect_timeout: 10
      search_path: star_public

# --- CI target (smoke tests — T-606) ---
# Used by scripts/ci_dbt_smoke.sh and .github/workflows/dbt-smoke.yml
# Copy the block below to your .dbt/profiles.yml (gitignored)

portfoliq_test:
  target: ci
  outputs:
    ci:
      type: postgres
      host: "{{ env_var('POSTGRES_HOST', 'localhost') }}"
      port: "{{ env_var('POSTGRES_PORT', '5432') | int }}"
      user: "{{ env_var('POSTGRES_USER', 'postgres') }}"
      password: "{{ env_var('POSTGRES_PASSWORD', 'test') }}"
      dbname: "{{ env_var('POSTGRES_DB', 'portfoliq_test') }}"
      schema: "{{ env_var('DBT_SCHEMA', 'star_public') }}"
      sslmode: disable
      threads: 4
      keepalives_idle: 0
      connect_timeout: 10
